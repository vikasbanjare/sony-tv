<?xml version="1.0" encoding="utf-8"?>
<!-- Only screen-content changes, only from the apps listed in SkipService, half a second apart at most.
     No key events are touched, so the remote works exactly as before. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="500"
    android:description="@string/skip_description" />
